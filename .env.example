# Personalized AI Board-Game Tutor — root environment.
# Copy to `.env` and fill in. `python main.py` fails without RADEON_API_KEY.

# ── AMD Token Factory (required) ─────────────────────────────────────────
# Your personal AMD API key. NEVER commit the real key.
RADEON_API_KEY=
# Base URL of the AMD OpenAI-compatible endpoint (from the event manual).
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Exact model ID — run `python -m tutor.run --list-models` to list live IDs.
# (Verified live on 2025-10-16: Gemma-4-31B-IT)
AMD_MODEL=Gemma-4-31B-IT

# ── Service URLs (defaults are fine for `python main.py`) ────────────────
RECOMMEND_URL=http://127.0.0.1:8001
RAG_URL=http://127.0.0.1:8100

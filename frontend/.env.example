# All variables are optional. Any service left blank runs in built-in demo mode,
# so the dashboard deploys and works with zero backend.

# Main tutor backend (POST /lesson, POST /ask, POST /quiz, POST /visual, GET /visual/{id})
VITE_API_URL=

# Recommendation engine (POST /recommend, GET /games)  e.g. http://localhost:8001
VITE_RECOMMEND_URL=

# RAG service (POST /rag/retrieve, GET /rag/games, GET /health)  e.g. http://localhost:8100
VITE_RAG_URL=

# Fall back to demo data when a configured service fails (true/false). Default true.
VITE_DEMO_FALLBACK=true

# Request timeout in milliseconds. Default 60000 (LLM calls can be slow).
VITE_TIMEOUT_MS=60000
